#pragma once

#include <string_view>

/**
 * @file CnaService/Version.hpp
 * @brief The cna-gamer-services-server release a translation unit is compiled against.
 *
 * Generated by cmake/Version.cmake from cmake/templates/Version.hpp.in. The version itself is
 * decided in one place only -- project(cna_gamer_services_server VERSION ...) and
 * CNA_GAMER_SERVICES_VERSION_PRERELEASE in the root CMakeLists.txt (see docs/releasing.md). Never
 * edit the generated copy in the build tree.
 *
 * This is the server's own release version. It is deliberately independent of two numbers it is
 * easy to confuse it with: the control and relay protocol version ("v1" in the wire format and in
 * protocol/v1.md, which moves only on an incompatible wire change) and a title's
 * `title-minimum-version`, which is the game's version, not the server's.
 *
 * The object-like macros exist because a constexpr value cannot be tested by the preprocessor and
 * because a string literal is what the Prometheus build_info line and the JSON diagnostics want;
 * use the functions for everything else.
 */

/** @brief Major component of the release, as a preprocessor-testable integer literal. */
#define CNA_GAMER_SERVICES_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/** @brief Minor component of the release, as a preprocessor-testable integer literal. */
#define CNA_GAMER_SERVICES_VERSION_MINOR @PROJECT_VERSION_MINOR@

/** @brief Patch component of the release, as a preprocessor-testable integer literal. */
#define CNA_GAMER_SERVICES_VERSION_PATCH @PROJECT_VERSION_PATCH@

/** @brief Pre-release identifier without its leading '-'; an empty string on a final release. */
#define CNA_GAMER_SERVICES_VERSION_PRERELEASE "@CNA_GAMER_SERVICES_VERSION_PRERELEASE@"

/** @brief The complete release string, e.g. "0.1.0" or "0.2.0-beta.1"; no leading 'v'. */
#define CNA_GAMER_SERVICES_VERSION_STRING "@CNA_GAMER_SERVICES_VERSION_STRING@"

namespace CnaService {

/** @brief The major component of the release being compiled against. */
[[nodiscard]] constexpr int getVersionMajor() noexcept { return CNA_GAMER_SERVICES_VERSION_MAJOR; }

/** @brief The minor component of the release being compiled against. */
[[nodiscard]] constexpr int getVersionMinor() noexcept { return CNA_GAMER_SERVICES_VERSION_MINOR; }

/** @brief The patch component of the release being compiled against. */
[[nodiscard]] constexpr int getVersionPatch() noexcept { return CNA_GAMER_SERVICES_VERSION_PATCH; }

/**
 * @brief The pre-release identifier of the release being compiled against.
 *
 * The leading '-' is not part of the value: the release 0.2.0-beta.1 reports "beta.1".
 * @return The identifier, or an empty view on a final release.
 */
[[nodiscard]] constexpr std::string_view getVersionPreRelease() noexcept {
    return CNA_GAMER_SERVICES_VERSION_PRERELEASE;
}

/** @brief The complete release string in Semantic Versioning spelling, e.g. "0.1.0". */
[[nodiscard]] constexpr std::string_view getVersionString() noexcept {
    return CNA_GAMER_SERVICES_VERSION_STRING;
}

/** @brief True for an alpha, beta or release-candidate build, false on a final release. */
[[nodiscard]] constexpr bool isPreReleaseVersion() noexcept { return !getVersionPreRelease().empty(); }

} // namespace CnaService
